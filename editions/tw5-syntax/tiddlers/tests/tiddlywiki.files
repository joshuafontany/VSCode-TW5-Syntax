{
    "directories": [
        {
            "path": "../../../../tests",
            "filesRegExp": "^.*\\.(json|cson|plist|tmLanguage)$",
            "isTiddlerFile": false,
            "fields": {
                "title": {
                    "source": "filename",
                    "prefix": "$:/tw5-syntax/tests/"
                },
                "type": "text/plain",
                "tags": "$:/tags/TW5Syntax/TestFixture",
                "text": {
                    "source": "text"
                }
            }
        },
        {
            "path": "../../../../tests/tiddlywiki5",
            "filesRegExp": "^.*\\.test$",
            "isTiddlerFile": false,
            "fields": {
                "title": {
                    "source": "filename",
                    "prefix": "$:/tw5-syntax/tests/tiddlywiki5/"
                },
                "type": "text/plain",
                "tags": "$:/tags/TW5Syntax/Assertion",
                "text": {
                    "source": "text"
                }
            }
        },
        {
            "path": "../../../../tests/memetic-wikitext",
            "filesRegExp": "^.*\\.test$",
            "isTiddlerFile": false,
            "fields": {
                "title": {
                    "source": "filename",
                    "prefix": "$:/tw5-syntax/tests/memetic-wikitext/"
                },
                "type": "text/plain",
                "tags": "$:/tags/TW5Syntax/Assertion",
                "text": {
                    "source": "text"
                }
            }
        },
        {
            "path": "../../../../tests/known-gaps",
            "filesRegExp": "^.*\\.(test|md)$",
            "isTiddlerFile": false,
            "fields": {
                "title": {
                    "source": "filename",
                    "prefix": "$:/tw5-syntax/tests/known-gaps/"
                },
                "type": "text/plain",
                "tags": "$:/tags/TW5Syntax/Assertion $:/tags/TW5Syntax/KnownGap",
                "text": {
                    "source": "text"
                }
            }
        },
        {
            "path": "../../../../tests/samples",
            "filesRegExp": "^.*\\.(tw|mem|tid|md|html|meta|multids|test)$",
            "isTiddlerFile": false,
            "fields": {
                "title": {
                    "source": "filename",
                    "prefix": "$:/tw5-syntax/tests/samples/"
                },
                "type": "text/plain",
                "tags": "$:/tags/TW5Syntax/Specimen",
                "text": {
                    "source": "text"
                }
            }
        },
        {
            "path": "../../../../tests/samples",
            "filesRegExp": "^.*\\.snap$",
            "isTiddlerFile": false,
            "fields": {
                "title": {
                    "source": "filename",
                    "prefix": "$:/tw5-syntax/tests/snapshots/"
                },
                "type": "text/plain",
                "tags": "$:/tags/TW5Syntax/Snapshot",
                "text": {
                    "source": "text"
                }
            }
        }
    ]
}
