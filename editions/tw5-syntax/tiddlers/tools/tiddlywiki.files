{
    "directories": [
        {
            "path": "../../../../tools",
            "filesRegExp": "^.*\\.(js|sh)$",
            "isTiddlerFile": false,
            "fields": {
                "title": {
                    "source": "filename",
                    "prefix": "$:/tw5-syntax/tools/"
                },
                "type": "application/javascript",
                "tags": "$:/tags/TW5Syntax/Tool",
                "text": {
                    "source": "text"
                }
            }
        }
    ]
}
