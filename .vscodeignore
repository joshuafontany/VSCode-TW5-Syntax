# The published extension carries the grammars, the snippets, the language
# configuration and its documentation. Everything below serves development.

.github/**
.vscode/**
.vscode-test/**
.gitignore
.vscodeignore

# Test harness: the fixtures, and the third-party grammars vendored so the
# embedded-language assertions resolve their scopes.
tests/**
run_tests.sh
tools/**

# Held for 2.2.0: the grammar and its configuration ride in the repository and run in
# CI, and the manifest registers neither, so the package carries neither.
syntaxes/memetic-wikitext.json
memetic-language-configuration.json

# Reference grammars. The extension ships none of them.
grammars_archive/**

# Resolved from package.json at install time.
node_modules/**
package-lock.json

*.vsix
