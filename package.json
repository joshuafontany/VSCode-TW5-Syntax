{
    "name": "tw5-syntax",
    "displayName": "TiddlyWiki5 Syntax",
    "description": "TiddlyWiki5 v5.3.4 Textmate compatible Syntax / Grammar",
    "version": "2.3.3",
    "icon": "tw5.png",
    "engines": {
        "vscode": "^1.43.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "keywords": [
        "tiddlywiki",
        "tiddlywiki5",
        "tw5",
        "textmate",
        "grammar",
        "syntax",
        "highlighting",
        "snippets",
        "shiki"
    ],
    "license": "BSD-3-Clause",
    "publisher": "joshua-fontany",
    "author": {
        "name": "Joshua Fontany",
        "email": "joshua.fontany@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/joshuafontany/VSCode-TW5-Syntax.git"
    },
    "contributes": {
        "languages": [
            {
                "id": "json",
                "extensions": [
                    ".info",
                    ".files"
                ],
                "aliases": [
                    "Tiddlywiki5 Json",
                    "tiddlywiki5-json"
                ]
            },
            {
                "id": "tiddlywiki5.test",
                "aliases": [
                    "Tiddlywiki Test",
                    "tiddlywiki5.test",
                    "tw5.test",
                    "tw.test"
                ],
                "extensions": [
                    ".tw5.test",
                    ".tiddlywiki5.test"
                ],
                "mimetypes": [
                    "text/vnd.tiddlywiki.test"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "tid",
                "aliases": [
                    "Tiddler",
                    "Tid",
                    "tid"
                ],
                "extensions": [
                    ".tid",
                    ".meta"
                ],
                "mimetypes": [
                    "application/x-tiddler"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "multids",
                "aliases": [
                    "MultiTiddlers",
                    "Multids",
                    "multids"
                ],
                "extensions": [
                    ".multids"
                ],
                "mimetypes": [
                    "application/x-tiddlers"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "tiddlywiki5",
                "aliases": [
                    "Tiddlywiki5",
                    "tiddlywiki5",
                    "tw5"
                ],
                "extensions": [
                    ".tw",
                    ".tw5",
                    ".tiddlywiki5"
                ],
                "mimetypes": [
                    "text/vnd.tiddlywiki"
                ],
                "configuration": "./language-configuration.json"
            },
        {
            "id": "memetic-wikitext",
            "aliases": [
                "Memetic-Wikitext",
                "memetic-wikitext",
                "mem"
            ],
            "extensions": [
                ".mem"
            ],
            "mimetypes": [
                "text/memetic-wikitext+tiddlywiki"
            ],
            "configuration": "./memetic-language-configuration.json"
        }
        ],
        "grammars": [
            {
                "language": "tiddlywiki5",
                "scopeName": "text.html.tiddlywiki5",
                "path": "./syntaxes/tiddlywiki5.json"
            },
            {
                "language": "tiddlywiki5.test",
                "scopeName": "text.html.tiddlywiki5.test",
                "path": "./syntaxes/tw5-test-file.json"
            },
            {
                "language": "tid",
                "scopeName": "source.tiddlywiki5.tid-file",
                "path": "./syntaxes/tw5-tid-file.json"
            },
            {
                "scopeName": "source.tiddlywiki5.fields",
                "path": "./syntaxes/tw5-fields.json"
            },
            {
                "scopeName": "source.tiddlywiki5.meta-file",
                "path": "./syntaxes/tw5-meta-file.json"
            },
            {
                "language": "multids",
                "scopeName": "source.tiddlywiki5.multids-file",
                "path": "./syntaxes/tw5-multids-file.json"
            },
        {
            "language": "memetic-wikitext",
            "scopeName": "text.html.tiddlywiki5.memetic-wikitext",
            "path": "./syntaxes/memetic-wikitext.json"
        }
        ],
        "snippets": [
            {
                "language": "tid",
                "path": "./snippets/snippets.json"
            },
            {
                "language": "multids",
                "path": "./snippets/snippets.json"
            },
            {
                "language": "tid",
                "path": "./snippets/tiddler-fields.json"
            },
            {
                "language": "multids",
                "path": "./snippets/tiddler-fields.json"
            },
            {
                "language": "tiddlywiki5",
                "path": "./snippets/snippets.json"
            }
        ],
        "configurationDefaults": {
            "files.associations": {
                "*.tiddlywiki5": "tiddlywiki5",
                "*.tw": "tiddlywiki5",
                "*.tw5": "tiddlywiki5",
                "*.tw5.test": "tiddlywiki5.test",
                "*.tid": "tid",
                "*.meta": "tid",
                "*.multids": "multids"
            }
        }
    },
    "dependencies": {},
    "devDependencies": {
        "vscode-tmgrammar-test": "^0.1.3",
        "tm-grammars": "^1.7.2",
        "tm-themes": "^1.4.1",
        "language-gfm": "https://github.com/atom/language-gfm",
        "vscode-jsp": "https://github.com/pthorsson/vscode-jsp"
    },
    "scripts": {
        "echo-test": "bash -c 'echo $(pwd) && echo ./tests/tiddlywiki5/*.tw5.test'",
        "list-test": "bash -c 'ls ./tests/tiddlywiki5/*.tw5.test'",
        "test": "bash ./run_tests.sh './tests/tiddlywiki5/*.tw5.test'",
        "tests-advanced": "bash ./run_tests.sh './tests/tiddlywiki5/html.advanced.tw5.test'",
        "tests-basic": "bash ./run_tests.sh './tests/tiddlywiki5/html.basic.tw5.test'",
        "tests-htmltiddler": "bash ./run_tests.sh './tests/tiddlywiki5/html.tiddler.tw5.test'",
        "tests-wikitext": "bash ./run_tests.sh './tests/tiddlywiki5/tiddlywiki5.*.tw5.test'",
        "tests-memetic": "bash ./run_tests.sh './tests/memetic-wikitext/*.mem.test'",
        "lint-closure": "node ./tools/terminator-closure.js ./syntaxes/memetic-wikitext.json",
        "test-tools": "node --test ./tests/tools/upstream-coverage.test.js ./tests/tools/composition-check.test.js ./tests/tools/nesting-coverage.test.js",
        "compose-wikitext": "node ./tools/composition-check.js text.html.tiddlywiki5 \"./tests/samples/*.tw\"",
        "compose-memetic": "node ./tools/composition-check.js text.html.tiddlywiki5.memetic-wikitext \"./tests/samples/*.mem\"",
        "compose": "npm run compose-wikitext",
        "upstream-coverage": "node ./tools/upstream-coverage.js",
        "nesting-coverage": "node ./tools/nesting-coverage.js",
        "corpus": "node ./tools/corpus-check.js",
        "corpus-verbose": "node ./tools/corpus-check.js --verbose",
        "package-contents": "node ./tools/package-contents.js",
        "bench": "bash ./tools/bench.sh live",
        "bench:packaged": "bash ./tools/bench.sh packaged",
        "bench:down": "bash ./tools/bench.sh down",
        "tests-known-gaps": "bash -c 'ls ./tests/known-gaps/*.tw5.test >/dev/null 2>&1 && bash ./run_tests.sh \"./tests/known-gaps/*.tw5.test\" || echo \"no known gap stands\"'",
        "snap-wikitext": "node ./tools/snapshot-check.js text.html.tiddlywiki5 './tests/samples/*.tw'",
        "snap-tid": "node ./tools/snapshot-check.js source.tiddlywiki5.tid-file './tests/samples/*.tid'",
        "snap-meta": "node ./tools/snapshot-check.js source.tiddlywiki5.tid-file './tests/samples/*.meta'",
        "snap-multids": "node ./tools/snapshot-check.js source.tiddlywiki5.multids-file './tests/samples/*.multids'",
        "snap-memetic": "node ./tools/snapshot-check.js text.html.tiddlywiki5.memetic-wikitext './tests/samples/*.mem'",
        "canary-wikitext": "node ./tools/bleed-canary.js text.html.tiddlywiki5 './tests/samples/*.tw'",
        "canary-memetic": "node ./tools/bleed-canary.js text.html.tiddlywiki5.memetic-wikitext './tests/samples/*.mem'",
        "canary-tid": "node ./tools/bleed-canary.js source.tiddlywiki5.tid-file \"./tests/samples/*.tid\"",
        "canary": "npm run canary-wikitext && npm run canary-tid && npm run canary-memetic",
        "snap": "npm run snap-wikitext && npm run snap-tid && npm run snap-meta && npm run snap-multids && npm run snap-memetic",
        "snap-update": "npm run snap-wikitext -- --update && npm run snap-tid -- --update && npm run snap-meta -- --update && npm run snap-multids -- --update && npm run snap-memetic -- --update"
    },
    "npmConfig": {
        "script-shell": "/bin/bash"
    }
}
