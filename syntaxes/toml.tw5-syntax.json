{
  "information_for_contributors": "PLACEHOLDER",
  "name": "toml",
  "scopeName": "source.toml.tw5-syntax",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#table-header"
    },
    {
      "include": "#key-value-line"
    },
    {
      "include": "#illegal-token"
    }
  ],
  "repository": {
    "comments": {
      "match": "(#).*$",
      "name": "comment.line.number-sign.toml",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.toml"
        }
      }
    },
    "illegal-token": {
      "match": "[^#\\s]+",
      "name": "invalid.illegal.unexpected-token.toml"
    },
    "table-header": {
      "patterns": [
        {
          "begin": "(\\[\\[)",
          "beginCaptures": {
            "1": {
              "name": "meta.brackets.toml punctuation.section.brackets.begin.toml"
            }
          },
          "end": "$",
          "name": "meta.section.toml",
          "patterns": [
            {
              "begin": "(?=[^\\s\\]])",
              "end": "(\\]\\])|(?=$)",
              "endCaptures": {
                "1": {
                  "name": "meta.brackets.toml punctuation.section.brackets.end.toml"
                }
              },
              "name": "meta.brackets.toml entity.name.section.toml",
              "patterns": [
                {
                  "include": "#table-header-content"
                }
              ]
            },
            {
              "include": "#comments"
            },
            {
              "include": "#illegal-token"
            }
          ]
        },
        {
          "begin": "(\\[)",
          "beginCaptures": {
            "1": {
              "name": "meta.brackets.toml punctuation.section.brackets.begin.toml"
            }
          },
          "end": "$",
          "name": "meta.section.toml",
          "patterns": [
            {
              "begin": "(?=[^\\s\\]])",
              "end": "(\\])|(?=$)",
              "endCaptures": {
                "1": {
                  "name": "meta.brackets.toml punctuation.section.brackets.end.toml"
                }
              },
              "name": "meta.brackets.toml entity.name.section.toml",
              "patterns": [
                {
                  "include": "#table-header-content"
                }
              ]
            },
            {
              "include": "#comments"
            },
            {
              "include": "#illegal-token"
            }
          ]
        }
      ]
    },
    "table-header-content": {
      "patterns": [
        {
          "match": "\\.",
          "name": "punctuation.accessor.dot.toml"
        },
        {
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.toml"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.toml"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        },
        {
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.toml"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.toml"
            }
          }
        },
        {
          "match": "[0-9A-Za-z_-]+"
        },
        {
          "match": "[ \\t]+"
        },
        {
          "match": "[^ \\t\\]\\.\"']+",
          "name": "invalid.illegal.toml"
        }
      ]
    },
    "key-value-line": {
      "begin": "(?=[\"'0-9A-Za-z_-])",
      "end": "$",
      "patterns": [
        {
          "begin": "(=)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.separator.key-value.toml"
            }
          },
          "end": "(?=[,#\\]\\}])|$",
          "name": "meta.mapping.value.toml",
          "patterns": [
            {
              "include": "#value"
            },
            {
              "include": "#comments"
            }
          ]
        },
        {
          "include": "#table-key"
        },
        {
          "include": "#comments"
        }
      ]
    },
    "table-key": {
      "patterns": [
        {
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.toml"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.toml"
            }
          },
          "name": "meta.mapping.key.toml string.quoted.double.toml",
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        },
        {
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.toml"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.toml"
            }
          },
          "name": "meta.mapping.key.toml string.quoted.single.toml"
        },
        {
          "match": "[0-9A-Za-z_-]+",
          "name": "meta.mapping.key.toml string.unquoted.toml"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.dot.toml"
        },
        {
          "match": "[ \\t]+"
        }
      ]
    },
    "value": {
      "patterns": [
        {
          "include": "#array"
        },
        {
          "include": "#inline-table"
        },
        {
          "include": "#boolean"
        },
        {
          "include": "#datetime"
        },
        {
          "include": "#number"
        },
        {
          "include": "#basic-multiline-string"
        },
        {
          "include": "#basic-string"
        },
        {
          "include": "#literal-multiline-string"
        },
        {
          "include": "#literal-string"
        }
      ]
    },
    "array": {
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.sequence.begin.toml"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.sequence.end.toml"
        }
      },
      "name": "meta.sequence.array.toml",
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.sequence.toml"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#value"
        }
      ]
    },
    "inline-table": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.mapping.begin.toml"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.mapping.end.toml"
        }
      },
      "name": "meta.mapping.toml",
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.sequence.toml"
        },
        {
          "begin": "(?=[\"'0-9A-Za-z_-])",
          "end": "(?=[,}])",
          "patterns": [
            {
              "begin": "(=)",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.separator.key-value.toml"
                }
              },
              "end": "(?=[,}])",
              "name": "meta.mapping.value.toml",
              "patterns": [
                {
                  "include": "#value"
                }
              ]
            },
            {
              "include": "#table-key"
            }
          ]
        }
      ]
    },
    "boolean": {
      "match": "\\b(?:false|true)\\b",
      "name": "constant.language.boolean.toml"
    },
    "datetime": {
      "patterns": [
        {
          "match": "[0-9]{4}(-)(?:0[0-9]|1[0-2])(-)(?:[0-2][0-9]|3[0-1])([ tT])(?:[01][0-9]|2[0-4])(:)[0-5][0-9](?:(:)(?:[0-6][0-9])(?:(\\.)[0-9]+)?)?(?:([zZ])|([-+])(?:[01][0-9]|2[0-4])(:)[0-5][0-9])?",
          "name": "constant.other.datetime.toml",
          "captures": {
            "1": {
              "name": "punctuation.separator.date.toml"
            },
            "2": {
              "name": "punctuation.separator.date.toml"
            },
            "3": {
              "name": "punctuation.separator.datetime.toml"
            },
            "4": {
              "name": "punctuation.separator.time.toml"
            },
            "5": {
              "name": "punctuation.separator.time.toml"
            },
            "6": {
              "name": "punctuation.separator.decimal.toml"
            },
            "7": {
              "name": "storage.modifier.timezone.toml"
            },
            "8": {
              "name": "keyword.operator.arithmetic.toml"
            },
            "9": {
              "name": "punctuation.separator.time.toml"
            }
          }
        },
        {
          "match": "[0-9]{4}(-)(?:0[0-9]|1[0-2])(-)(?:[0-2][0-9]|3[0-1])",
          "name": "constant.other.date.toml",
          "captures": {
            "1": {
              "name": "punctuation.separator.date.toml"
            },
            "2": {
              "name": "punctuation.separator.date.toml"
            }
          }
        },
        {
          "match": "(?:[01][0-9]|2[0-4]):[0-5][0-9](?:(:)(?:[0-6][0-9])(?:(\\.)[0-9]+)?)?",
          "name": "constant.other.time.toml",
          "captures": {
            "1": {
              "name": "punctuation.separator.time.toml"
            },
            "2": {
              "name": "punctuation.separator.decimal.toml"
            }
          }
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "([-+])?(inf|nan)\\b",
          "name": "meta.number.float.other.toml",
          "captures": {
            "1": {
              "name": "keyword.operator.arithmetic.toml"
            },
            "2": {
              "name": "constant.numeric.value.toml"
            }
          }
        },
        {
          "match": "([-+]?)((?:[1-9][0-9_]+|[0-9])(?:(\\.)(?:[0-9][0-9_]*)(?:[eE][-+]?(?:[0-9][0-9_]*))?|(?:[eE][-+]?(?:[0-9][0-9_]*))))",
          "name": "meta.number.float.decimal.toml",
          "captures": {
            "1": {
              "name": "keyword.operator.arithmetic.toml"
            },
            "2": {
              "name": "constant.numeric.value.toml"
            },
            "3": {
              "name": "punctuation.separator.decimal.toml"
            }
          }
        },
        {
          "match": "(0b)([01][01_]*)?",
          "name": "meta.number.integer.binary.toml",
          "captures": {
            "1": {
              "name": "constant.numeric.base.toml"
            },
            "2": {
              "name": "constant.numeric.value.toml"
            }
          }
        },
        {
          "match": "(0o)([0-7][0-7_]*)?",
          "name": "meta.number.integer.octal.toml",
          "captures": {
            "1": {
              "name": "constant.numeric.base.toml"
            },
            "2": {
              "name": "constant.numeric.value.toml"
            }
          }
        },
        {
          "match": "(0x)([0-9A-Fa-f][0-9A-Fa-f_]*)?",
          "name": "meta.number.integer.hexadecimal.toml",
          "captures": {
            "1": {
              "name": "constant.numeric.base.toml"
            },
            "2": {
              "name": "constant.numeric.value.toml"
            }
          }
        },
        {
          "match": "([-+]?)((?:[1-9][0-9_]+|[0-9]))",
          "name": "meta.number.integer.decimal.toml",
          "captures": {
            "1": {
              "name": "keyword.operator.arithmetic.toml"
            },
            "2": {
              "name": "constant.numeric.value.toml"
            }
          }
        }
      ]
    },
    "basic-multiline-string": {
      "begin": "\"\"\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.toml"
        }
      },
      "end": "\"{3,5}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.toml"
        }
      },
      "name": "meta.string.toml string.quoted.double.block.toml",
      "patterns": [
        {
          "include": "#string-escapes"
        }
      ]
    },
    "basic-string": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.toml"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.toml"
        }
      },
      "name": "meta.string.toml string.quoted.double.toml",
      "patterns": [
        {
          "include": "#string-escapes"
        }
      ]
    },
    "literal-multiline-string": {
      "begin": "'''",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.toml"
        }
      },
      "end": "'{3,5}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.toml"
        }
      },
      "name": "meta.string.toml string.quoted.single.block.toml"
    },
    "literal-string": {
      "begin": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.toml"
        }
      },
      "end": "'",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.toml"
        }
      },
      "name": "meta.string.toml string.quoted.single.toml"
    },
    "string-escapes": {
      "patterns": [
        {
          "match": "\\\\[btnfre\"\\\\]",
          "name": "constant.character.escape.toml"
        },
        {
          "match": "\\\\x\\h{2}",
          "name": "constant.character.escape.unicode.8bit.toml"
        },
        {
          "match": "\\\\u\\h{4}",
          "name": "constant.character.escape.unicode.16bit.toml"
        },
        {
          "match": "\\\\U\\h{8}",
          "name": "constant.character.escape.unicode.32bit.toml"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.string.escape.toml"
        }
      ]
    }
  }
}
