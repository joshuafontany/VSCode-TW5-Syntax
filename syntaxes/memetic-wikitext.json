{
    "name": "Memetic-Wikitext",
    "scopeName": "text.html.tiddlywiki5.memetic-wikitext",
    "fileTypes": [
        "mem"
    ],
    "patterns": [
        {
            "include": "text.html.tiddlywiki5"
        }
    ],
    "repository": {
        "memetic": {
            "patterns": [
                {
                    "include": "#sigil"
                },
                {
                    "include": "#lar-uri"
                },
                {
                    "include": "#fragment"
                },
                {
                    "include": "#bearing"
                }
            ]
        },
        "lar-uri": {
            "comment": "A lar: URI reads as an address wherever it stands, sigil or prose. TW5 binds no rule to the scheme, so the base grammar takes its '//' for an italic run. The colon separates a scheme; only '=' names a parameter.",
            "name": "markup.underline.link.lar.memetic-wikitext",
            "begin": "\\b(lar)(:)(//[^\\s>\"'?#\\]]*)",
            "end": "(?=[\\s>\"'\\]])|$",
            "beginCaptures": {
                "1": {
                    "name": "keyword.other.scheme.lar.memetic-wikitext"
                },
                "2": {
                    "name": "punctuation.separator.scheme.lar.memetic-wikitext"
                },
                "3": {
                    "name": "string.unquoted.uri.lar.memetic-wikitext",
                    "patterns": [
                        {
                            "comment": "The authority: a persona, the role it holds, and the place it stands.",
                            "match": "(//)([^:@/\\s]+)(:)([^@/\\s]+)(@)([^/\\s]+)",
                            "captures": {
                                "1": {
                                    "name": "punctuation.definition.authority.lar.memetic-wikitext"
                                },
                                "2": {
                                    "name": "entity.name.persona.lar.memetic-wikitext"
                                },
                                "3": {
                                    "name": "punctuation.separator.role.lar.memetic-wikitext"
                                },
                                "4": {
                                    "name": "support.role.lar.memetic-wikitext"
                                },
                                "5": {
                                    "name": "punctuation.separator.authority.lar.memetic-wikitext"
                                },
                                "6": {
                                    "name": "entity.name.place.lar.memetic-wikitext"
                                }
                            }
                        },
                        {
                            "comment": "An empty authority, which the document form writes.",
                            "match": "(//)(?=/)",
                            "captures": {
                                "1": {
                                    "name": "punctuation.definition.authority.lar.memetic-wikitext"
                                }
                            }
                        },
                        {
                            "comment": "The root segment: heading, angle of approach, carried dynamic.",
                            "match": "(/)([A-Za-z0-9_-]+)(\\.)([A-Za-z0-9_-]+)(\\.)([A-Za-z0-9_-]+)(?=[/\\s>\"']|$)",
                            "captures": {
                                "1": {
                                    "name": "punctuation.separator.path.lar.memetic-wikitext"
                                },
                                "2": {
                                    "name": "entity.name.tag.heading.lar.memetic-wikitext"
                                },
                                "3": {
                                    "name": "punctuation.separator.root.lar.memetic-wikitext"
                                },
                                "4": {
                                    "name": "entity.name.tag.angle.lar.memetic-wikitext"
                                },
                                "5": {
                                    "name": "punctuation.separator.root.lar.memetic-wikitext"
                                },
                                "6": {
                                    "name": "entity.name.tag.dynamic.lar.memetic-wikitext"
                                }
                            }
                        },
                        {
                            "comment": "Any other path separator.",
                            "match": "/",
                            "name": "punctuation.separator.path.lar.memetic-wikitext"
                        }
                    ]
                }
            },
            "patterns": [
                {
                    "comment": "A value claims everything up to the next separator.",
                    "match": "(?<==)[^\\s>\"'&#\\]]+",
                    "name": "string.unquoted.memetic-wikitext"
                },
                {
                    "include": "#named-param"
                },
                {
                    "include": "#fragment"
                },
                {
                    "match": "[?&]",
                    "name": "punctuation.separator.query.memetic-wikitext"
                }
            ]
        },
        "fragment": {
            "comment": "A fragment names an anchor. This corpus writes it with a leading slash and dots.",
            "match": "(#)([/A-Za-z0-9_][/A-Za-z0-9_.-]*)",
            "captures": {
                "1": {
                    "name": "punctuation.definition.anchor.memetic-wikitext"
                },
                "2": {
                    "name": "entity.name.tag.anchor.memetic-wikitext"
                }
            }
        },
        "bearing": {
            "patterns": [
                {
                    "match": "(?<=[\\s>])->(?=[\\s>])",
                    "name": "keyword.operator.bearing.arrow.memetic-wikitext"
                }
            ],
            "comment": "The bearing arrow rides as an unnamed positional between two named ends. A bare `?` names nothing on its own — an end states itself as `from=?` or `to=?`, where the glyph reads as an ordinary value."
        },
        "named-param": {
            "comment": "The memetic standard writes key=value. TiddlyWiki reads `=` as the new-style separator (parseMacroParameterAsAttribute in core/modules/parsers/parseutils.js), which admits a filtered, indirect or macro value; a colon admits neither and demands a strict identifier so $:/foo cannot mis-parse.",
            "match": "\\b([A-Za-z0-9_-]+)\\s*(=)",
            "captures": {
                "1": {
                    "name": "entity.other.attribute-name.memetic-wikitext"
                },
                "2": {
                    "name": "keyword.operator.assignment.memetic-wikitext"
                }
            }
        },
        "sigil": {
            "comment": "The verb a sigil says. TiddlyWiki reads `<<~ set …>>` as a call on a variable spelled `~`, so the verb binds as a POSITIONAL argument and the base paints it like any unquoted value — `set`, `oracle` and `lares` all read `string.unquoted`. The dialect names it BESIDE that reading rather than instead of it: the host builds a transclusion here and the base must keep saying so.",
            "patterns": [
                {
                    "comment": "An opening sigil, and a closing one, which TiddlyWiki reads as part of the variable name.",
                    "match": "(?<=<<~)[ \\t]*(/?)([a-zA-Z][\\w-]*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.sigil.close.memetic-wikitext"
                        },
                        "2": {
                            "name": "entity.name.function.sigil.memetic-wikitext"
                        }
                    }
                }
            ]
        }
    },
    "injections": {
        "R:text.html.tiddlywiki5": {
            "comment": "Sigils keep their reading everywhere the base grammar reads wikitext.\n\nThe base wraps everything after the pragma zone in a region of its own — a mode, not a construct — and a rule standing at this dialect’s top level cannot reach inside one.\nAn injection can: the base’s root scope stands on the stack wherever it reads, region or no region, so one selector reaches the whole file.\nNaming the block contexts one at a time reached the three somebody listed.",
            "patterns": [
                {
                    "include": "text.html.tiddlywiki5.memetic-wikitext#memetic"
                }
            ]
        },
        "L:text.html.tiddlywiki5": {
            "comment": "A bearing arrow stands BETWEEN two named ends, inside a sigil where the base grammar's unquoted-value rule would take its dash and leave the angle to the parameters region — two tokens, neither named. An L-priority injection looks before that rule and keeps the arrow whole. It reaches only where this dialect stands, because a grammar's injections ride with the grammar.",
            "patterns": [
                {
                    "include": "text.html.tiddlywiki5.memetic-wikitext#bearing"
                }
            ]
        }
    }
}
