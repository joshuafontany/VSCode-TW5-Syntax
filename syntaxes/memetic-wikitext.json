{
	"name": "Memetic-Wikitext",
	"scopeName": "text.html.tiddlywiki5.memetic-wikitext",
	"fileTypes": [
		"mem"
	],
	"patterns": [
		{
			"include": "#memetic"
		},
		{
			"include": "text.html.tiddlywiki5"
		}
	],
	"repository": {
		"memetic": {
			"patterns": [
				{
					"include": "#declaration"
				},
				{
					"include": "#control-soh"
				},
				{
					"include": "#control-stx"
				},
				{
					"include": "#control-etx"
				},
				{
					"include": "#control-eot"
				},
				{
					"include": "#control-other"
				},
				{
					"include": "#sigil-close"
				},
				{
					"include": "#sigil-unresolved"
				},
				{
					"include": "#sigil-pragma"
				},
				{
					"include": "#sigil"
				},
				{
					"include": "#lar-uri"
				}
			]
		},
		"declaration": {
			"name": "meta.carrier.declaration.memetic-wikitext",
			"begin": "(<<)(!DOCTYPE)(?=[\\s>])",
			"end": "(>>)|$",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.begin.memetic-wikitext"
				},
				"2": {
					"name": "keyword.control.declaration.memetic-wikitext"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.end.memetic-wikitext"
				}
			},
			"patterns": [
				{
					"include": "#params"
				}
			]
		},
		"control-soh": {
			"name": "meta.carrier.control.soh.memetic-wikitext",
			"begin": "(<<)(\\^)(?=\\s+code\\s*[=:]\\s*\"&#x00(01|11);\")",
			"end": "(>>)|$",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.begin.memetic-wikitext"
				},
				"2": {
					"name": "keyword.control.carrier.soh.memetic-wikitext"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.end.memetic-wikitext"
				}
			},
			"patterns": [
				{
					"include": "#params"
				}
			]
		},
		"control-stx": {
			"name": "meta.carrier.control.stx.memetic-wikitext",
			"begin": "(<<)(\\^)(?=\\s+code\\s*[=:]\\s*\"&#x0002;\")",
			"end": "(>>)|$",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.begin.memetic-wikitext"
				},
				"2": {
					"name": "keyword.control.carrier.stx.memetic-wikitext"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.end.memetic-wikitext"
				}
			},
			"patterns": [
				{
					"include": "#params"
				}
			]
		},
		"control-etx": {
			"name": "meta.carrier.control.etx.memetic-wikitext",
			"begin": "(<<)(\\^)(?=\\s+code\\s*[=:]\\s*\"&#x00(03|17);\")",
			"end": "(>>)(\\s*(ni:///[a-z0-9-]+;[A-Za-z0-9_-]+))?|$",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.begin.memetic-wikitext"
				},
				"2": {
					"name": "keyword.control.carrier.etx.memetic-wikitext"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.end.memetic-wikitext"
				},
				"3": {
					"name": "constant.other.blockcheck.memetic-wikitext"
				}
			},
			"patterns": [
				{
					"include": "#params"
				}
			]
		},
		"control-eot": {
			"name": "meta.carrier.control.eot.memetic-wikitext",
			"begin": "(<<)(\\^)(?=\\s+code\\s*[=:]\\s*\"&#x00(04|14);\")",
			"end": "(>>)|$",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.begin.memetic-wikitext"
				},
				"2": {
					"name": "keyword.control.carrier.eot.memetic-wikitext"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.end.memetic-wikitext"
				}
			},
			"patterns": [
				{
					"include": "#params"
				}
			]
		},
		"control-other": {
			"name": "meta.carrier.control.memetic-wikitext",
			"begin": "(<<)(\\^)(?=[\\s>])",
			"end": "(>>)|$",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.begin.memetic-wikitext"
				},
				"2": {
					"name": "keyword.control.carrier.memetic-wikitext"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.end.memetic-wikitext"
				}
			},
			"patterns": [
				{
					"include": "#params"
				}
			]
		},
		"sigil-close": {
			"name": "meta.sigil.close.memetic-wikitext",
			"comment": "The tooth stands at one dispatch position: <<~ then LWSP then the command word. A close word carries its own slash, so the tooth scopes as the tooth and the slash rides on the word — mirroring the plain register's <<fragment …>> and <</fragment>>.",
			"match": "(<<)(~)\\s*(/)\\s*(\\\\?[A-Za-z_][A-Za-z0-9_-]*)\\s*(>>)",
			"captures": {
				"1": {
					"name": "punctuation.definition.sigil.begin.memetic-wikitext"
				},
				"2": {
					"name": "keyword.control.sharktooth.memetic-wikitext"
				},
				"3": {
					"name": "punctuation.definition.sigil.close.memetic-wikitext"
				},
				"4": {
					"name": "entity.name.function.sigil.memetic-wikitext"
				},
				"5": {
					"name": "punctuation.definition.sigil.end.memetic-wikitext"
				}
			}
		},
		"sigil-unresolved": {
			"name": "meta.sigil.unresolved.memetic-wikitext",
			"begin": "(<<)(~\\?)(?=[\\s>#])",
			"end": "(>>)|$",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.begin.memetic-wikitext"
				},
				"2": {
					"name": "keyword.control.sharktooth.unresolved.memetic-wikitext"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.end.memetic-wikitext"
				}
			},
			"patterns": [
				{
					"include": "#params"
				}
			],
			"comment": "A fragment may follow the tooth directly: the grammar puts LWSP, never required space, between them."
		},
		"sigil-pragma": {
			"name": "meta.sigil.pragma.memetic-wikitext",
			"begin": "(<<)(~!)\\s*(\\\\?[A-Za-z_][A-Za-z0-9_-]*)",
			"end": "(>>)|$",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.begin.memetic-wikitext"
				},
				"2": {
					"name": "keyword.control.sharktooth.pragma.memetic-wikitext"
				},
				"3": {
					"name": "entity.name.function.sigil.definition.memetic-wikitext"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.end.memetic-wikitext"
				}
			},
			"patterns": [
				{
					"include": "#params"
				}
			],
			"comment": "LWSP admits zero between the tooth and the name, as it does for the speaking set."
		},
		"sigil": {
			"name": "meta.sigil.memetic-wikitext",
			"begin": "(<<)(~)\\s*(\\\\?[A-Za-z_][A-Za-z0-9_-]*)",
			"end": "(>>)|$",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.begin.memetic-wikitext"
				},
				"2": {
					"name": "keyword.control.sharktooth.memetic-wikitext"
				},
				"3": {
					"name": "entity.name.function.sigil.memetic-wikitext"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.sigil.end.memetic-wikitext"
				}
			},
			"patterns": [
				{
					"include": "#params"
				}
			],
			"comment": "The sharktooth claims both spacings: <<~ name …>> and <<~name …>>. TW5 reads the first as macro `~` with a positional parameter and the second as macro `~name`, and both stand inside this namespace. LWSP in the grammar admits zero (memetic-wikitext #grammar)."
		},
		"params": {
			"patterns": [
				{
					"include": "#bearing"
				},
				{
					"include": "#lar-uri"
				},
				{
					"include": "#fragment"
				},
				{
					"include": "#named-param"
				},
				{
					"include": "#named-param-colon"
				},
				{
					"include": "#string"
				},
				{
					"include": "#param-value"
				}
			]
		},
		"bearing": {
			"patterns": [
				{
					"match": "(?<=[\\s>])->(?=[\\s>])",
					"name": "keyword.operator.bearing.arrow.memetic-wikitext"
				}
			],
			"comment": "The bearing arrow rides as an unnamed positional between two named ends. A bare `?` names nothing on its own — an end states itself as `from=?` or `to=?`, where the glyph reads as an ordinary value."
		},
		"lar-uri": {
			"comment": "A lar: URI reads as an address wherever it stands, sigil or prose. TW5 binds no rule to the scheme, so the base grammar takes its '//' for an italic run. The colon separates a scheme; only '=' names a parameter.",
			"name": "markup.underline.link.lar.memetic-wikitext",
			"begin": "\\b(lar)(:)(//[^\\s>\"'?#\\]]*)",
			"end": "(?=[\\s>\"'\\]])|$",
			"beginCaptures": {
				"1": {
					"name": "keyword.other.scheme.lar.memetic-wikitext"
				},
				"2": {
					"name": "punctuation.separator.scheme.lar.memetic-wikitext"
				},
				"3": {
					"name": "string.unquoted.uri.lar.memetic-wikitext",
					"patterns": [
						{
							"comment": "The authority: a persona, the role it holds, and the place it stands.",
							"match": "(//)([^:@/\\s]+)(:)([^@/\\s]+)(@)([^/\\s]+)",
							"captures": {
								"1": {
									"name": "punctuation.definition.authority.lar.memetic-wikitext"
								},
								"2": {
									"name": "entity.name.persona.lar.memetic-wikitext"
								},
								"3": {
									"name": "punctuation.separator.role.lar.memetic-wikitext"
								},
								"4": {
									"name": "support.role.lar.memetic-wikitext"
								},
								"5": {
									"name": "punctuation.separator.authority.lar.memetic-wikitext"
								},
								"6": {
									"name": "entity.name.place.lar.memetic-wikitext"
								}
							}
						},
						{
							"comment": "An empty authority, which the document form writes.",
							"match": "(//)(?=/)",
							"captures": {
								"1": {
									"name": "punctuation.definition.authority.lar.memetic-wikitext"
								}
							}
						},
						{
							"comment": "The root segment: heading, angle of approach, carried dynamic.",
							"match": "(/)([A-Za-z0-9_-]+)(\\.)([A-Za-z0-9_-]+)(\\.)([A-Za-z0-9_-]+)(?=[/\\s>\"']|$)",
							"captures": {
								"1": {
									"name": "punctuation.separator.path.lar.memetic-wikitext"
								},
								"2": {
									"name": "entity.name.tag.heading.lar.memetic-wikitext"
								},
								"3": {
									"name": "punctuation.separator.root.lar.memetic-wikitext"
								},
								"4": {
									"name": "entity.other.attribute-name.angle.lar.memetic-wikitext"
								},
								"5": {
									"name": "punctuation.separator.root.lar.memetic-wikitext"
								},
								"6": {
									"name": "entity.name.function.dynamic.lar.memetic-wikitext"
								}
							}
						},
						{
							"comment": "Any other path separator.",
							"match": "/",
							"name": "punctuation.separator.path.lar.memetic-wikitext"
						}
					]
				}
			},
			"patterns": [
				{
					"comment": "A value claims everything up to the next separator.",
					"match": "(?<==)[^\\s>\"'&#\\]]+",
					"name": "string.unquoted.memetic-wikitext"
				},
				{
					"include": "#named-param"
				},
				{
					"include": "#fragment"
				},
				{
					"match": "[?&]",
					"name": "punctuation.separator.query.memetic-wikitext"
				}
			]
		},
		"fragment": {
			"comment": "A fragment names an anchor. This corpus writes it with a leading slash and dots.",
			"match": "(#)([/A-Za-z0-9_][/A-Za-z0-9_.-]*)",
			"captures": {
				"1": {
					"name": "punctuation.definition.anchor.memetic-wikitext"
				},
				"2": {
					"name": "entity.name.tag.anchor.memetic-wikitext"
				}
			}
		},
		"named-param": {
			"comment": "The memetic standard writes key=value. TiddlyWiki reads `=` as the new-style separator (parseMacroParameterAsAttribute in core/modules/parsers/parseutils.js), which admits a filtered, indirect or macro value; a colon admits neither and demands a strict identifier so $:/foo cannot mis-parse.",
			"match": "\\b([A-Za-z0-9_-]+)\\s*(=)",
			"captures": {
				"1": {
					"name": "entity.other.attribute-name.memetic-wikitext"
				},
				"2": {
					"name": "keyword.operator.assignment.memetic-wikitext"
				}
			}
		},
		"string": {
			"patterns": [
				{
					"name": "string.quoted.double.memetic-wikitext",
					"begin": "\"",
					"end": "\"|$",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.memetic-wikitext"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.memetic-wikitext"
						}
					}
				},
				{
					"name": "string.quoted.single.memetic-wikitext",
					"begin": "'",
					"end": "'|$",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.memetic-wikitext"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.memetic-wikitext"
						}
					}
				},
				{
					"name": "string.quoted.bracket.memetic-wikitext",
					"begin": "\\[\\[",
					"end": "\\]\\]|$",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.memetic-wikitext"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.memetic-wikitext"
						}
					}
				}
			]
		},
		"named-param-colon": {
			"match": "\\b([A-Za-z0-9_-]+)(:)(?=[\"']|\\[\\[)",
			"captures": {
				"1": {
					"name": "entity.other.attribute-name.memetic-wikitext"
				},
				"2": {
					"name": "punctuation.separator.key-value.memetic-wikitext"
				}
			},
			"comment": "The TiddlyWiki spelling, still valid and still read. The lookahead keeps a colon inside a lar: URI or a ratio from reading as a separator."
		},
		"param-value": {
			"comment": "Only `=` names a parameter, so only `=` introduces a value. A colon-separated parameter carries a quoted value and the string rule claims it; a scheme colon introduces a path, never a value.",
			"match": "(?<==)[^\\s>\"']+",
			"name": "string.unquoted.memetic-wikitext"
		}
	},
	"injections": {
		"L:meta.paragraph.tiddlywiki5, markup.quote.quoteblock.tiddlywiki5, markup.list": {
			"comment": "Sigils keep their reading inside base block contexts.",
			"patterns": [
				{
					"include": "text.html.tiddlywiki5.memetic-wikitext#memetic"
				}
			]
		}
	}
}
