{
  "name": "TiddlyWiki5 fields",
  "scopeName": "source.tiddlywiki5.fields",
  "patterns": [{ "include": "#comment" }, { "include": "#field" }],
  "repository": {
    "comment": {
      "match": "^(#).*$",
      "name": "comment.line.number-sign.tiddlywiki5.fields",
      "captures": {
        "1": { "name": "punctuation.definition.comment.tiddlywiki5.fields" }
      }
    },
    "field": {
      "patterns": [
        {
          "match": "^([^:]*?)(:)(.*?)$",
          "name": "meta.tiddler.field.tiddlywiki5",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.field.tiddlywiki5",
              "patterns": [
                {
                  "comment": "Only control characters are illegal in field names since TW5 v5.2.x",
                  "match": "(?=[\\x00-\\x1f])(.*)",
                  "name":"invalid.illegal.field.name.tiddlywiki5"
                 }
              ]
            },
            "2": {
              "name": "punctuation.separator.key-value.field.tiddlywiki5"
            },
            "3": {
              "comment": "Field values are plain strings in the header",
              "name": "string.unquoted.field.value.tiddlywiki5"
            }
          }
        }
      ]
    }
  }
}
