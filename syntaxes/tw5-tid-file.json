{
  "name": "TiddlyWiki5 tid file",
  "scopeName": "source.tiddlywiki5.tid-file",
  "fileTypes": [
    "tid"
  ],
  "patterns": [
    {
      "comment": "Tokenize tiddler text field.",
      "begin": "(?<=^$)",
      "contentName": "meta.text.html.tiddlywiki5",
      "patterns": [
        {
          "include": "text.html.tiddlywiki5"
        }
      ]
    },
    {
      "comment": "Tokenize mandatory tiddler metadata.",
      "begin": "^",
      "end": "^$",
      "contentName": "meta.text.tiddler.fields.tiddlywiki5",
      "patterns": [
        {
          "include": "source.tiddlywiki5.fields"
        }
      ]
    }
  ],
  "injections": {
    "L:meta.variable.macro.body.tiddlywiki5": {
      "comment": "Text replacement, which a define body takes and the other three definition bodies do not. A grammar wrapping another keys its injections on its own scope, so the wrapped grammar own never fire here.",
      "patterns": [
        {
          "include": "text.html.tiddlywiki5#substitute-filter"
        },
        {
          "include": "text.html.tiddlywiki5#substitute-param"
        },
        {
          "include": "text.html.tiddlywiki5#substitute-variable"
        }
      ]
    }
  }
}
