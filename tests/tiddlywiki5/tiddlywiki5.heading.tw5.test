# SYNTAX TEST "text.html.tiddlywiki5" "Test for header syntaxes"

! Header
#<- text.html.tiddlywiki5 meta.heading.heading-1.tiddlywiki5 markup.heading.tiddlywiki5
#^ text.html.tiddlywiki5 meta.heading.heading-1.tiddlywiki5

!! Header
#<-- text.html.tiddlywiki5 meta.heading.heading-2.tiddlywiki5 markup.heading.tiddlywiki5
# ^ text.html.tiddlywiki5 meta.heading.heading-2.tiddlywiki5

!!! Header
