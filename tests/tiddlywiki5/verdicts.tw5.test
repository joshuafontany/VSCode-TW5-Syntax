# SYNTAX TEST "text.html.tiddlywiki5" "A verdict stands only where TiddlyWiki refuses"

! Where TiddlyWiki builds a node, no verdict stands

an &foo; here
#  ^ - invalid.illegal.ambiguous-ampersand.html.tiddlywiki5
#  ^ text.html.tiddlywiki5 meta.paragraph.tiddlywiki5 constant.character.entity.named.html.tiddlywiki5 punctuation.definition.entity.html.tiddlywiki5
#   ^^^ text.html.tiddlywiki5 meta.paragraph.tiddlywiki5 constant.character.entity.named.html.tiddlywiki5
#      ^ text.html.tiddlywiki5 meta.paragraph.tiddlywiki5 constant.character.entity.named.html.tiddlywiki5 punctuation.definition.entity.html.tiddlywiki5

{{multi
line}}
#^^^ - invalid.illegal.multiline-text-reference.tiddlywiki5
#^^^ text.html.tiddlywiki5 meta.transclusion.transcludeblock.tiddlywiki5 meta.transclusion.tokenize.tiddlywiki5 meta.transclusion.text-reference.tiddlywiki5

{{multi
line||Template}}
#^^^ - invalid.illegal.multiline-text-reference.tiddlywiki5

{{a||Temp
late}}
#^^^ - invalid.illegal.multiline-tiddler-title.tiddlywiki5

an x{{a
b}}x inline
#^ - invalid.illegal.multiline-text-reference.tiddlywiki5

{{{a
b}}}
#^ - invalid.illegal.multiline-tiddler-title.tiddlywiki5

! Where TiddlyWiki yields plain text, the verdict stands

a &verylongname; b
# ^ text.html.tiddlywiki5 meta.paragraph.tiddlywiki5 invalid.illegal.ambiguous-ampersand.html.tiddlywiki5

<$widget = >
#        ^ text.html.tiddlywiki5 meta.tag.widget.widget.html.tiddlywiki5 invalid.illegal.character-not-allowed-here.html.tiddlywiki5

A stray < in prose.
#       ^ text.html.tiddlywiki5 meta.paragraph.tiddlywiki5 invalid.illegal.bad-angle-bracket.html.tiddlywiki5

# html.js reads any [a-zA-Z0-9\-\$\.]+ as a tag name, so a custom element is ordinary markup.
<mytag>x</mytag>
#^^^^^ - invalid.illegal.unrecognized-tag.html.tiddlywiki5

<my-widget attr="v">y</my-widget>
#^^^^^^^^^ - invalid.illegal.unrecognized-tag.html.tiddlywiki5

<div =foo>y</div>
#    ^ text.html.tiddlywiki5 meta.tag.structure.div.start.html.tiddlywiki5 invalid.illegal.character-not-allowed-here.html.tiddlywiki5

# A style block's closing marker takes the rest of its line as ordinary content, and TiddlyWiki
# builds a paragraph node from it. Measured: two nodes, zero diagnostics.
@@color:red;
content
@@ trailing words
#  ^ - invalid.illegal.tiddlywiki5

# The HTML claim stands where TiddlyWiki's does not. The align attribute parses and renders;
# the verdict names HTML's own deprecation, never a refusal by this parser.
<div align="left">x</div>
#    ^^^^^ text.html.tiddlywiki5 meta.tag.structure.div.start.html.tiddlywiki5 meta.attribute.align.html.tiddlywiki5 invalid.deprecated.entity.other.attribute-name.html.tiddlywiki5

# A self-closing tag with a name TiddlyWiki does not know still builds a node.
<mytag />
#^^^^^ text.html.tiddlywiki5 meta.tag.other.unrecognized.html.tiddlywiki5 entity.name.tag.html.tiddlywiki5

<foo bar="baz" />
#^^^ - invalid.illegal.unrecognized-tag.html.tiddlywiki5

# An equals sign where a value belongs leaves the whole tag as plain text, so the verdict stands.
<div style==>x</div>
#          ^ text.html.tiddlywiki5 meta.tag.structure.div.start.html.tiddlywiki5 invalid.illegal.unexpected-equals-sign.html.tiddlywiki5

# SVG stands in TiddlyWiki's own shipped tiddlers, and its elements build nodes like any other.
<svg width="10"><circle cx="1" cy="1" r="1" fill="blue"/></svg>
#                 ^^^^^^ - invalid.illegal.unrecognized-tag.html.tiddlywiki5

<path d="M 1 2" fill="black"/>
#^^^^ - invalid.illegal.unrecognized-tag.html.tiddlywiki5

# reTagName admits the dollar and the dot, so a parameter substitution stands as a tag name.
<$type$ class="x">y</$type$>
#<- - invalid.illegal.bad-angle-bracket.html.tiddlywiki5

# A slash before the closing bracket marks a tag self-closing, for any tag at all.
<th/>
#  ^ - invalid.illegal.character-not-allowed-here.html.tiddlywiki5

<div style="height:0.5em;"/>
#                         ^ - invalid.illegal.character-not-allowed-here.html.tiddlywiki5
