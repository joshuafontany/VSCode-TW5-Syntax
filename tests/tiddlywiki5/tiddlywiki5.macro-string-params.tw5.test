# SYNTAX TEST "text.html.tiddlywiki5" "Test for string parameters with : and = separators in macro calls"

\procedure p(a1) <$text text=<<a1>>/>

<<p foo1>> -
#<- meta.variable.macrocallblock.tiddlywiki5 punctuation.definition.macrocallblock.begin.tiddlywiki5
# ^ meta.variable.macrocallblock.tiddlywiki5 variable.name.macro.tiddlywiki5
