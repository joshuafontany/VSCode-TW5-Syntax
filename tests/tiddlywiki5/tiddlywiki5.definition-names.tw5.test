# SYNTAX TEST "text.html.tiddlywiki5.test" "A definition name admits what TiddlyWiki admits"

# Both definition rules read the same name class — [^(\s]+ — so a dollar stands in a name of any
# of the four kinds, and TiddlyWiki builds each one:
#
#   \define $foo() body        name "$foo"       body "body"
#   \procedure $p() body       name "$p"         body "body"
#   \widget $my.thing() body   name "$my.thing"  body "body"
#
# A name the grammar refuses reads as paragraph text, and an author writing tiddlers on disk sees
# prose where a definition stands.
#
# A widget's name reads with or without its dollar, because fnprocdef.js reads `[^(\s]+` for all
# three kinds and builds the definition either way. widget.js resolves a custom widget by looking
# up "$" + the element's type, so a name without the dollar defines a variable no element reaches —
# and it still stands in pragma mode, so every pragma below it goes on reading as a pragma.

! A define takes a dollar in its name

\define $foo() body
#       ^^^^ entity.name.variable.macro.tiddlywiki5
#              ^^^^ meta.variable.macro.body.tiddlywiki5

! So does a procedure

\procedure $p() body
#          ^^ entity.name.variable.procedure.tiddlywiki5

! So does a function

\function $f() [tag[Task]]
#         ^^ entity.name.variable.function.tiddlywiki5

! A widget takes one

\widget $my.thing() body
#       ^^^^^^^^^ entity.name.variable.widget.tiddlywiki5

! A widget without one still defines, and its body reads as a body

\widget widget-without-a-dollar() body
#       ^^^^^^^^^^^^^^^^^^^^^^^ entity.name.variable.widget.tiddlywiki5
#                                  ^^^^ meta.variable.widget.body.tiddlywiki5

! A system title is no widget name

\widget $:/sys() body
#       ^^^^^^ - entity.name.variable.widget.tiddlywiki5
