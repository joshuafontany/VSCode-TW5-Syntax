# SYNTAX TEST "text.html.tiddlywiki5" "Test for MVV and [[...]] as widget attribute values"

<$text text=((myvar))/>
#      ^ entity.other.attribute-name.html.tiddlywiki5
#          ^ punctuation.separator.key-value.html.tiddlywiki5
#           ^^ meta.attribute.mvv.html.tiddlywiki5 punctuation.definition.mvv.attribute.begin.tiddlywiki5
#             ^ meta.attribute.mvv.html.tiddlywiki5 variable.name.mvv.attribute.tiddlywiki5
#                  ^^ meta.attribute.mvv.html.tiddlywiki5 punctuation.definition.mvv.attribute.end.tiddlywiki5

<$list filter=((myfilter))>
#      ^ entity.other.attribute-name.html.tiddlywiki5
#            ^ punctuation.separator.key-value.html.tiddlywiki5
#             ^^ meta.attribute.mvv.html.tiddlywiki5 punctuation.definition.mvv.attribute.begin.tiddlywiki5
#               ^ meta.attribute.mvv.html.tiddlywiki5 variable.name.mvv.attribute.tiddlywiki5
#                       ^^ meta.attribute.mvv.html.tiddlywiki5 punctuation.definition.mvv.attribute.end.tiddlywiki5
</$list>

<$text text=[[value with spaces]]/>
#      ^ entity.other.attribute-name.html.tiddlywiki5
#          ^ punctuation.separator.key-value.html.tiddlywiki5
#           ^^ string.quoted.bracket.attribute.html.tiddlywiki5 punctuation.definition.string.begin.html.tiddlywiki5
#             ^ string.quoted.bracket.attribute.html.tiddlywiki5
#                              ^^ string.quoted.bracket.attribute.html.tiddlywiki5 punctuation.definition.string.end.html.tiddlywiki5

# parseutils.js#parseMVVReferenceAsTransclusion reads the name as `[^\s>"'=:)]+` — no whitespace —
# then skipWhiteSpace (newlines included) up to `))`. A space inside or before the name breaks the
# match outright, and the host reads the whole `((...))` as an ordinary unquoted string instead.

# Red: a space inside the name never builds an MVV.
<$text text=((a b))/>
#           ^ - meta.attribute.mvv.html.tiddlywiki5
#             ^ - meta.attribute.mvv.html.tiddlywiki5
#               ^ - meta.attribute.mvv.html.tiddlywiki5
#                ^ - meta.attribute.mvv.html.tiddlywiki5

# Red: leading whitespace before the name never builds an MVV either.
<$text text=(( x))/>
#           ^ - meta.attribute.mvv.html.tiddlywiki5
#              ^ - meta.attribute.mvv.html.tiddlywiki5

# Control: trailing whitespace before the close still builds one.
<$text text=((x ))/>
#           ^^ meta.attribute.mvv.html.tiddlywiki5 punctuation.definition.mvv.attribute.begin.tiddlywiki5
#             ^ meta.attribute.mvv.html.tiddlywiki5 variable.name.mvv.attribute.tiddlywiki5
#               ^^ meta.attribute.mvv.html.tiddlywiki5 punctuation.definition.mvv.attribute.end.tiddlywiki5

# Control: the same trailing whitespace, carried across the line, still builds one.
<$text text=((x
#           ^^ meta.attribute.mvv.html.tiddlywiki5 punctuation.definition.mvv.attribute.begin.tiddlywiki5
#             ^ meta.attribute.mvv.html.tiddlywiki5 variable.name.mvv.attribute.tiddlywiki5
 ))/>
#^^ meta.attribute.mvv.html.tiddlywiki5 punctuation.definition.mvv.attribute.end.tiddlywiki5
