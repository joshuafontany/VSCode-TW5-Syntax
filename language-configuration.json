{
    "comments": {
        "blockComment": [ "<!--", "-->" ]
    },
    // symbols used as brackets
    "brackets": [
        ["<!--", "-->"],
        ["{", "}"],
        ["[", "]"],
    ],
    // WHO DECIDES A BRACKET'S COLOUR. VS Code colours a bracket by its NESTING DEPTH out of
    // `editorBracketHighlight.foreground1..6`, over the top of the colour a theme and this grammar
    // agreed on, and it takes the pairs to colour from `brackets` above unless this list stands.
    // Wikitext spells `{{`, `{{{`, `[[` and `((` as ONE marker each, which the editor reads as two or
    // three nested pairs — measured in Gruvbox Dark and Monokai, `{{MyTiddler}}` painted its outer
    // brace depth-1 and its inner brace depth-2 while every scope on both braces stood identical. An
    // empty list hands the DEPTH colour back to the grammar; `brackets` goes on serving matching, the
    // jump commands and the indent rules — and matching still paints a bracket it reads as unmatched in
    // the theme's unexpected-bracket red, over any colour a scope earns. tools/bracket-witness.js reads
    // every carrier for that red.
    "colorizedBracketPairs": [],
    // symbols the editor closes for you when typing
    "autoClosingPairs": [
        // A bare < opens an html tag and closes nothing; << opens a macro call and closes.
        { "open": "<<", "close": ">>" },
        { "open": "[[", "close": "]]" },
        { "open": "{", "close": "}"},
        { "open": "[", "close": "]"},
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"" },
        { "open": "<!--", "close": "-->", "notIn": ["comment", "string"] }
    ],
    "autoCloseBefore": ";:.,=}])>` \n\t",
    // symbols that surround a selection
    "surroundingPairs": [
        ["<<", ">>"],
        ["[[", "]]"],
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["<%", "%>"],
        ["\"", "\""],
        ["'", "'"],
        ["`", "`"]
    ],
    // A TiddlyWiki word. VS Code's default breaks a system title at its first character —
    // $:/core/ui/ViewTemplate selects as "$" — and halves a hyphenated variable name, so
    // tv-config-toolbar selects as "tv". Both stand among the commonest things an author
    // double-clicks. This takes a system title whole with its slashes, a pragma with its
    // backslash, a hyphenated name entire, and a number.
    // PRESSING ENTER INSIDE A BLOCK CONTINUES THE BLOCK.
    //
    // `appendText` takes a FIXED string and no backreference, so a rule cannot echo the marker its
    // own `beforeText` matched — each depth wants its own rule. Measured over this corpus: `*` opens
    // 357 lines, `#` 22, `>` 7, `**` 2 and `***` 1, so depth three covers every list this repository
    // writes, and the ceiling stands here rather than in a reader's surprise.
    //
    // THE CEILING, NAMED: depth four and deeper continues nothing, and a MIXED marker (`*#`) reads as
    // no rule here. VS Code cannot spell either without a runtime to compute the text, and a wrong
    // `appendText` would continue an ordered list with a bullet — worse than continuing nothing.
    //
    // A lookahead holds each rule to its own depth: `^\\*(?!\\*)` reads a single bullet and leaves `**`
    // to the rule beneath it, so one line never fires two rules.
    "onEnterRules": [
        { "beforeText": "^\\*(?!\\*)\\s+\\S", "action": { "indent": "none", "appendText": "* " } },
        { "beforeText": "^\\*\\*(?!\\*)\\s+\\S", "action": { "indent": "none", "appendText": "** " } },
        { "beforeText": "^\\*\\*\\*(?!\\*)\\s+\\S", "action": { "indent": "none", "appendText": "*** " } },
        { "beforeText": "^#(?!#)\\s+\\S", "action": { "indent": "none", "appendText": "# " } },
        { "beforeText": "^##(?!#)\\s+\\S", "action": { "indent": "none", "appendText": "## " } },
        { "beforeText": "^###(?!#)\\s+\\S", "action": { "indent": "none", "appendText": "### " } },
        { "beforeText": "^>(?!>)\\s*\\S", "action": { "indent": "none", "appendText": "> " } }
    ],
    "wordPattern": "(\\$:\\/[^\\s\\|\\[\\]\\{\\}<>\"'`]+)|(-?\\d*\\.\\d\\w*)|(\\\\?[A-Za-z_$][A-Za-z0-9_$-]*)",
    // No offSide. That rule says a blank line belongs to the indented block above it, and
    // TiddlyWiki ends a block AT a blank line — wikiparser.js takes /\r?\n\r?\n/ as the
    // boundary. Of the indented lines in TiddlyWiki own tiddlers three quarters carry prose,
    // which nests nothing, so folding them across the blank lines that separate paragraphs
    // offers a reader regions the format never had.
    "folding": {
        "markers": {
            "start": "^\\s*<!--\\s*#?region\\b.*-->",
            "end": "^\\s*<!--\\s*#?endregion\\b.*-->"
        }
    }
}