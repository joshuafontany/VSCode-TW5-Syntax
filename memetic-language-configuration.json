{
    // Memetic-wikitext extends TiddlyWiki wikitext, so it keeps the host's comment
    // form. Everything else here answers to the sharktooth.
    "comments": {
        "blockComment": [ "<!--", "-->" ]
    },
    // "<<" and ">>" bracket every sigil, so bracket matching and jump-to-pair follow
    // the grammar rather than the HTML underneath it.
    "brackets": [
        ["<!--", "-->"],
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    // WHO DECIDES A BRACKET'S COLOUR. VS Code colours a bracket by its NESTING DEPTH out of
    // `editorBracketHighlight.foreground1..6`, over the top of the colour a theme and this grammar
    // agreed on, and it takes the pairs to colour from `brackets` above unless this list stands.
    // Wikitext spells `{{`, `{{{`, `[[` and `((` as ONE marker each, which the editor reads as two or
    // three nested pairs — measured in Gruvbox Dark and Monokai, `{{MyTiddler}}` painted its outer
    // brace depth-1 and its inner brace depth-2 while every scope on both braces stood identical. An
    // empty list hands the colour back to the grammar; `brackets` goes on serving matching, the jump
    // commands and the indent rules.
    "colorizedBracketPairs": [],
    "autoClosingPairs": [
        { "open": "<<", "close": " >>" },
        { "open": "[[", "close": "]]" },
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"" },
        { "open": "<!--", "close": "-->", "notIn": ["comment", "string"] }
    ],
    "autoCloseBefore": ";:.,=}])> \n\t",
    "surroundingPairs": [
        ["<%", "%>"],
        ["<<", ">>"],
        ["[[", "]]"],
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"],
        ["`", "`"]
    ],
    // A sigil name, a lar: URI and a #fragment each select as one word, so a double
    // click takes the whole address.
    "wordPattern": "(\\$:\\/[^\\s\\|\\[\\]\\{\\}<>\"'`]+)|(lar:[^\\s>]+)|(#[A-Za-z_][A-Za-z0-9_-]*)|(-?\\d*\\.\\d\\w*)|(\\\\?[A-Za-z_$][A-Za-z0-9_$-]*)",
    // A sigil block closes on a name, and a folding marker matches text rather than
    // names. Structural folding waits for a language server that can pair a close
    // with its open; region markers stand until then.
    "folding": {
        "markers": {
            "start": "^\\s*<!--\\s*#?region\\b.*-->",
            "end": "^\\s*<!--\\s*#?endregion\\b.*-->"
        }
    }
}
